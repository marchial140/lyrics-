[Unit]
Description=LyricLive background worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lyriclive
WorkingDirectory=/opt/lyriclive/server
ExecStart=/usr/bin/node --env-file=.env src/main.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lyriclive/server/data
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
